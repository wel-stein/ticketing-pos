# Copy to server/.env and fill in. Never commit the real .env.

# ── Database ──────────────────────────────────────────────────────────────
DB_SERVER=your-sql-server-host
DB_PORT=1433
DB_DATABASE=dbmanjapos
DB_USER=
DB_PASSWORD=

# Set to false only if your SQL Server has a certificate the host actually trusts.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# ── API ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Session / auth ────────────────────────────────────────────────────────
SESSION_TTL_HOURS=12
# Must be true in production (HTTPS only).
COOKIE_SECURE=false
AUTH_MAX_FAILED=5
AUTH_LOCKOUT_MINUTES=15
